# Local Postgres from docker-compose.yml (port 5433, so it does not clash with a Postgres installed on the machine)
DATABASE_URL=postgres://recycle:recycle@localhost:5433/recycle
# Leave empty for test mode (demo results, no cost). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5 (cheapest)
CLAUDE_MODEL=claude-opus-5-5
PORT=3000
